# ═══════════════════════════════════════════════════════════════════════
# Weft Backend — Environment Variables
# Copy this file to .env and fill in real values for your environment.
# ═══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
APP_NAME="Weft API"
APP_VERSION="1.0.0"
ENV=development
DEBUG=true
API_V1_PREFIX=/v1

# ── Database (PostgreSQL 15 + PostGIS 3.4) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://weft:weft_dev@localhost:5432/weft_dev
TEST_DATABASE_URL=postgresql+asyncpg://weft:weft_dev@localhost:5432/weft_test
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis 7 ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT / Auth (RS256) ──────────────────────────────────────────────
# Generate RSA key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the PEM contents here (use \n for newlines in .env)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# ── AWS ─────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=weft-issues-dev
CLOUDFRONT_DOMAIN=""

# ── Firebase / FCM ──────────────────────────────────────────────────
# Path to service account JSON or the JSON content itself
FCM_SERVICE_ACCOUNT_JSON=""
FCM_PROJECT_ID=""

# ── reCAPTCHA v3 ────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_SCORE_THRESHOLD=0.5

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated origins (parsed as JSON list in config.py)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://weft.city","https://admin.weft.city"]
